# WayFinder Backend — Environment Variables
# Copy this file to .env and fill in your values.

# ─── Django ─────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-random-64-char-string
DEBUG=True
ALLOWED_HOSTS=*

# ─── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list. Leave empty for dev (allows all when DEBUG=True).
# CORS_ALLOWED_ORIGINS=https://app.wayfinder-ai.com

# ─── Dev Auth ───────────────────────────────────────────────────────────────────
# Set to True to allow 'Bearer dev-token' without Firebase.
# NEVER enable in production.
ALLOW_DEV_AUTH=True

# ─── Database ───────────────────────────────────────────────────────────────────
# Leave empty to use SQLite (dev default).
# DB_ENGINE=postgresql
# DB_NAME=wayfinder
# DB_USER=wayfinder
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# ─── Redis ──────────────────────────────────────────────────────────────────────
# Leave empty to use in-memory channel layer (dev default).
# REDIS_URL=redis://localhost:6379/0

# ─── Firebase ───────────────────────────────────────────────────────────────────
# Option A: Path to service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
# Option B: JSON string (for cloud deployments)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# ─── AI Model ───────────────────────────────────────────────────────────────────
# Leave empty for mock mode (no GPU needed).
# RYNNBRAIN_MODEL_PATH=Qwen/Qwen3-VL-2B-Instruct

# ─── Upload Limits ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
