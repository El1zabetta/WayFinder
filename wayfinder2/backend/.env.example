# ═══════════════════════════════════════════════════════════════════════════════
# WayFinder 2.0 — Environment Variables
# Copy to .env and fill in real values: cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Django ─────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=CHANGE-ME-to-a-random-50-char-string
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# ─── PostgreSQL ─────────────────────────────────────────────────────────────────
DB_ENGINE=postgresql
DB_NAME=wayfinder
DB_USER=wayfinder
DB_PASSWORD=CHANGE-ME-strong-db-password
DB_HOST=db
DB_PORT=5432

# Postgres container credentials (must match above)
POSTGRES_DB=wayfinder
POSTGRES_USER=wayfinder
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password

# ─── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Firebase ──────────────────────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-credentials.json

# ─── RynnBrain Model ───────────────────────────────────────────────────────────
RYNNBRAIN_MODEL_PATH=Alibaba-DAMO-Academy/RynnBrain-2B

# ─── Gunicorn ───────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# ─── SSL / Domain ──────────────────────────────────────────────────────────────
DOMAIN=your-domain.com
EMAIL=your-email@example.com

# ─── Logging ────────────────────────────────────────────────────────────────────
LOG_DIR=/var/log/wayfinder
