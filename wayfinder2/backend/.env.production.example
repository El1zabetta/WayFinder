# ═══════════════════════════════════════════════════════════════════════════════
# WayFinder 3.0 — Production Environment Variables
# Copy to .env.production and fill in real values: cp .env.production.example .env.production
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Django Settings ───────────────────────────────────────────────────────────
SECRET_KEY=CHANGE-ME-to-a-random-50-char-string
DEBUG=False
ALLOWED_HOSTS=api.wayfinder-ai.com,localhost,127.0.0.1

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_ENGINE=postgresql
DB_NAME=wayfinder
DB_USER=wayfinder_admin
DB_PASSWORD=CHANGE-ME-strong-db-password
DB_HOST=db
DB_PORT=5432

# Postgres container internals (must match above)
POSTGRES_DB=wayfinder
POSTGRES_USER=wayfinder_admin
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password

# ─── Redis & Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── Firebase / Auth ───────────────────────────────────────────────────────────
# Path inside the container where service account JSON is mounted
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-credentials.json
FIREBASE_PROJECT_ID=wayfinder-483708

# ─── AI Model (RynnBrain-2B) ───────────────────────────────────────────────────
RYNNBRAIN_MODEL_PATH=Alibaba-DAMO-Academy/RynnBrain-2B
MODEL_DEVICE=cuda
MODEL_PRECISION=float16
MAX_FRAME_SIZE=640

# ─── WebSocket & Performance ───────────────────────────────────────────────────
WS_TIMEOUT_SECONDS=300
CORS_ALLOWED_ORIGINS=https://wayfinder-ai.com,https://api.wayfinder-ai.com

# ─── Production Server ─────────────────────────────────────────────────────────
DOMAIN=api.wayfinder-ai.com
EMAIL=admin@wayfinder-ai.com
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
